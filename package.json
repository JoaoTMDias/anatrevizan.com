{
	"name": "anatrevizan.com",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"dev": "tinacms dev -c \"cross-env ASTRO_DEV_BACKGROUND=0 astro dev\"",
		"dev:preview": "pnpm dev",
		"build": "pnpm sync:orcid && pnpm validate:content && tinacms build --content=local -c \"astro build\" && node --experimental-strip-types scripts/report-build-output.ts production",
		"build:local": "pnpm sync:orcid && pnpm validate:content && tinacms build --local --skip-cloud-checks -c \"astro build\" && node --experimental-strip-types scripts/report-build-output.ts production",
		"build:local:unchecked": "pnpm sync:orcid && pnpm validate:content && tinacms build --local --skip-cloud-checks -c \"astro build\"",
		"build:preview": "pnpm sync:orcid && pnpm validate:content && cross-env EDITORIAL_PREVIEW=true tinacms build --local --skip-cloud-checks -c \"astro build\" && node --experimental-strip-types scripts/report-build-output.ts preview",
		"build:search": "tinacms search-index",
		"preview": "cross-env HOST=127.0.0.1 PORT=4322 node dist/server/entry.mjs",
		"preview:editorial": "pnpm build:preview && pnpm preview",
		"astro": "astro",
		"lint": "biome lint .",
		"format": "biome format --write ./src",
		"format:check": "biome format ./src",
		"check": "pnpm lint && pnpm format:check && pnpm exec astro check",
		"test": "vitest run",
		"test:publishing": "pnpm build:preview && node --experimental-strip-types scripts/assert-build-output.ts preview && pnpm build:local:unchecked && node --experimental-strip-types scripts/report-build-output.ts production --allow-empty-production && node --experimental-strip-types scripts/assert-build-output.ts production",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"sync:orcid": "node --env-file-if-exists=.env --experimental-strip-types scripts/sync-orcid.ts --mode=build",
		"sync:orcid:strict": "node --env-file-if-exists=.env --experimental-strip-types scripts/sync-orcid.ts --mode=strict",
		"sync:orcid:initial": "node --env-file-if-exists=.env --experimental-strip-types scripts/sync-orcid.ts --mode=strict --allow-anonymous",
		"tina:lock": "node --experimental-strip-types scripts/generate-tina-lock.ts",
		"validate:content": "node --experimental-strip-types scripts/validate-content.ts"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.2.6",
		"@astrojs/mdx": "^8.0.0",
		"@astrojs/netlify": "^8.2.5",
		"@astrojs/node": "^11.1.5",
		"@astrojs/react": "^6.0.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@astrojs/vercel": "^11.0.9",
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource/fira-sans": "^5.3.0",
		"@hookform/resolvers": "^5.9.1",
		"@iconify-json/tabler": "^1.2.38",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tinacms/astro": "^0.6.1",
		"astro": "^7.2.10",
		"astro-icon": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.38.0",
		"react-hook-form": "^7.87.0",
		"shadcn": "^4.19.1",
		"sharp": "^0.35.4",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.11",
		"@jtmdias/react-a11y-tools": "^3.1.1",
		"@netlify/functions": "^6.0.0",
		"@playwright/test": "^1.62.1",
		"@tinacms/cli": "^2.6.1",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"cross-env": "^10.1.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tinacms": "^3.12.1",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
