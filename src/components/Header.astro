---
import HeaderMenu from "./HeaderMenu";
import type { CmsConfig } from "../lib/data";
import { isRouteKey, pathFor, type PublishedLocale, type RouteKey } from "../lib/routing";
interface Props {
  config?: CmsConfig | null;
  locale?: PublishedLocale;
  routeKey?: RouteKey;
  languageAvailable?: boolean;
}
const { config, locale = "pt-PT", routeKey = "home", languageAvailable = false } = Astro.props;
type RouteKeyItem<T extends { routeKey: string }> = T & { routeKey: RouteKey };
const hasRouteKey = <T extends { routeKey: string }>(item: T): item is RouteKeyItem<T> =>
  isRouteKey(item.routeKey);
const languageField = locale === "pt-PT" ? "pt" : "en";
const present = <T,>(value: T | null): value is T => value !== null;
const navigation = (config?.navigation ?? [])
  .filter(present)
  .filter((item) => Boolean(item.label))
  .filter(hasRouteKey);
const labelFor = (value: { pt: string; en: string } | null | undefined) =>
  value?.[languageField] ?? "";
const isCurrentSection = (item: (typeof navigation)[number]) =>
  item.routeKey === routeKey || (item.children ?? []).some((child) => child?.routeKey === routeKey);
const navigationItems = navigation.map((item) => ({
  item,
  itemRoute: item.routeKey,
  children: (item.children ?? [])
    .filter(present)
    .filter((child) => Boolean(child.label))
    .filter(hasRouteKey),
}));
const bookingItem = navigation.find((item) => item.routeKey === "booking");
const desktopItems = navigationItems.map(({ item, itemRoute, children }) => ({
  type: item.type,
  label: labelFor(item.label),
  href: pathFor(itemRoute, locale),
  emphasis: item.emphasis ?? false,
  isCurrent: itemRoute === routeKey,
  isCurrentSection: isCurrentSection(item),
  children: children.map((child) => ({
    label: labelFor(child.label),
    description: child.description ? labelFor(child.description) : undefined,
    tag: child.tag ? labelFor(child.tag) : undefined,
    highlight: child.highlight ?? false,
    href: pathFor(child.routeKey, locale),
    isCurrent: child.routeKey === routeKey,
  })),
}));
const alternateLocale = locale === "en" ? "pt-PT" : "en";
const languageLink = languageAvailable
  ? {
      label: locale === "en" ? "PT" : "EN",
      mobileLabel: locale === "en" ? "Português" : "English",
      accessibleLabel: locale === "en" ? "Mudar para português" : "Switch to English",
      href: pathFor(routeKey, alternateLocale),
      lang: alternateLocale,
      hreflang: alternateLocale,
    }
  : undefined;
---

<a
  class="sr-only focus:fixed focus:left-4 focus:top-3 focus:z-[70] focus:block focus:rounded-md focus:bg-background focus:px-4 focus:py-2 focus:text-foreground focus:shadow-lg"
  href="#main-content">{locale === "en" ? "Skip to content" : "Saltar para o conteúdo"}</a
>
<header
  class="fixed inset-x-0 top-0 z-50 h-16 border-b border-border/80 bg-background shadow-sm md:h-20"
>
  <nav
    aria-label={locale === "en" ? "Main navigation" : "Navegação principal"}
    class="site-container flex h-full items-center justify-between gap-4"
  >
    <a
      href={pathFor("home", locale)}
      class="shrink-0 font-heading text-xl font-bold text-primary md:text-2xl"
      aria-current={routeKey === "home" ? "page" : undefined}
      >{config?.identity?.name ?? "Dra. Ana Trevizan"}</a
    >
    <HeaderMenu
      client:load
      items={desktopItems}
      languageLink={languageLink}
      brand={config?.identity?.name ?? "Dra. Ana Trevizan"}
      homeHref={pathFor("home", locale)}
      menuLabel={locale === "en" ? "Main menu" : "Menu principal"}
      closeLabel={locale === "en" ? "Close menu" : "Fechar menu"}
    />
  </nav>
</header>
