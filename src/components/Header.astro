---
import { SkipLinks } from "@jtmdias/react-a11y-tools";
import HeaderStickyState from "./HeaderStickyState";
import HeaderMenu from "./HeaderMenu";
import LogoHeader from "./LogoHeader.astro";
import ThemeToggle from "./ThemeToggle.astro";
import type { CmsConfig } from "../lib/data";
import { navigationItems } from "../lib/navigation";
import { pathFor, publishedLocales, type PublishedLocale, type RouteKey } from "../lib/routing";
interface Props {
  config?: CmsConfig | null;
  locale?: PublishedLocale;
  routeKey?: RouteKey;
  availableLocales?: PublishedLocale[];
}
const { config, locale = "pt-PT", routeKey = "home", availableLocales = publishedLocales } = Astro.props;
const isEnglish = locale === "en";
const navigation = navigationItems(config?.navigation, locale);
const isCurrentSection = (item: (typeof navigation)[number]) =>
  item.routeKey === routeKey || (item.children ?? []).some((child) => child.routeKey === routeKey);
const renderedNavigation = navigation.map((item) => ({
  item,
  itemRoute: item.routeKey,
  children: item.children ?? [],
}));
const desktopItems = renderedNavigation.map(({ item, itemRoute, children }) => ({
  type: item.type,
  label: item.label,
  href: pathFor(itemRoute, locale),
  emphasis: item.emphasis ?? false,
  isCurrent: itemRoute === routeKey,
  isCurrentSection: isCurrentSection(item),
  children: children.map((child) => ({
    label: child.label,
    description: child.description,
    tag: child.tag,
    highlight: child.highlight ?? false,
    href: pathFor(child.routeKey, locale),
    isCurrent: child.routeKey === routeKey,
  })),
}));
const languageLocales = availableLocales.length > 1 ? availableLocales : publishedLocales;
const languageOptions = languageLocales.map((candidate) => ({
  locale: candidate,
  label: candidate === "pt-PT" ? "Português (Portugal)" : candidate === "pt-BR" ? "Português (Brasil)" : "English",
  flag: candidate === "pt-PT" ? "🇵🇹" : candidate === "pt-BR" ? "🇧🇷" : "🇬🇧",
  href: pathFor(routeKey, candidate),
}));
const currentLanguage = languageOptions.find((option) => option.locale === locale) ?? languageOptions[0];
---

<SkipLinks
  items={[
    {
      target: "#main-content",
      text: isEnglish ? "Skip to content" : "Saltar para o conteúdo",
    },
  ]}
/>
<HeaderStickyState client:load />
<header data-site-header class="site-header">
  <nav
    aria-label={isEnglish ? "Main navigation" : "Navegação principal"}
    class="site-container flex h-full items-center justify-between gap-4"
  >
    <a
      href={pathFor("home", locale)}
      class="shrink-0"
      aria-current={routeKey === "home" ? "page" : undefined}
    >
      <LogoHeader />
      <span class="sr-only">Ana Trevizan</span>
    </a>
    <div class="header-actions">
      <HeaderMenu
        client:load
        items={desktopItems}
        languageOptions={languageOptions}
        currentLanguage={currentLanguage}
        menuLabel={isEnglish ? "Main menu" : "Menu principal"}
        closeLabel={isEnglish ? "Close menu" : "Fechar menu"}
      />
      <ThemeToggle locale={locale} compact />
    </div>
  </nav>
</header>
