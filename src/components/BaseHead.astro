---
import '../styles/global.css';
import { pathFor, routeMap, type PublishedLocale, type RouteKey } from '../lib/routing';
interface Props { title: string; description: string; locale: PublishedLocale; routeKey: RouteKey; image?: string; noindex?: boolean; canonicalOrigin?: string; availableLocales?: PublishedLocale[] }
const { title, description, locale, routeKey, image, noindex = false, canonicalOrigin, availableLocales = [] } = Astro.props;
const origin = new URL(canonicalOrigin ?? Astro.site ?? 'https://anatrevizan.com');
const canonical = new URL(pathFor(routeKey, locale), origin);
const pt = new URL(routeMap[routeKey]['pt-PT'], origin);
const en = new URL(routeMap[routeKey].en, origin);
---
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{title}</title><meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{availableLocales.includes('pt-PT') && <link rel="alternate" hreflang="pt-PT" href={pt} />}
{availableLocales.includes('en') && <link rel="alternate" hreflang="en" href={en} />}
{availableLocales.includes('pt-PT') && <link rel="alternate" hreflang="x-default" href={pt} />}
{noindex && <meta name="robots" content="noindex,nofollow" />}
<meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:locale" content={locale === 'en' ? 'en_GB' : 'pt_PT'} /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image, origin)} />}
