---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
interface Props { data?: CmsEditorial | null }
const { data } = Astro.props;
---
{data && <article id="main-content" class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20">
	{data.approvalPending && <p role="status" class="mb-6 rounded border border-amber-500 p-3 text-sm">{data.locale === 'en' ? 'Structural content awaiting editorial approval.' : 'Conteúdo estrutural a aguardar aprovação editorial.'}</p>}
	<h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
	{data.summary && <p data-tina-field={tinaField(data, 'summary')}>{data.summary}</p>}
	{data.body && <div class="whitespace-pre-line" data-tina-field={tinaField(data, 'body')}>{data.body}</div>}
</article>}
