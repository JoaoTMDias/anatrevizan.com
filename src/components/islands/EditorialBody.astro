---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import AboutPage from '../editorial/AboutPage.astro';
import AcademicHubPage from '../editorial/AcademicHubPage.astro';
import AcademicServicePage from '../editorial/AcademicServicePage.astro';
import ConsultingHubPage from '../editorial/ConsultingHubPage.astro';
import ConsultingServicePage from '../editorial/ConsultingServicePage.astro';
import EventsPage from '../editorial/EventsPage.astro';
import HomePage from '../editorial/HomePage.astro';
import PublicationsPage from '../editorial/PublicationsPage.astro';
import SpeakingPage from '../editorial/SpeakingPage.astro';
import ContactPage from '../editorial/ContactPage.astro';
import BookingPage from '../editorial/BookingPage.astro';
interface Props { data?: CmsEditorial | null }
const { data } = Astro.props;
---
{data?.routeKey === 'home' ? <HomePage data={data} /> : data?.routeKey === 'about' ? <AboutPage data={data} /> : data?.routeKey === 'consulting' ? <ConsultingHubPage data={data} /> : data?.consultingService ? <ConsultingServicePage data={data} /> : data?.routeKey === 'academic' ? <AcademicHubPage data={data} /> : data?.academicService ? <AcademicServicePage data={data} /> : data?.routeKey === 'publications' ? <PublicationsPage data={data} /> : data?.routeKey === 'events' ? <EventsPage data={data} /> : data?.routeKey === 'speaking' ? <SpeakingPage data={data} /> : data?.routeKey === 'contact' ? <ContactPage data={data} /> : data?.routeKey === 'booking' ? <BookingPage data={data} /> : data && <article id="main-content" class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20">
	{data.approvalPending && <p role="status" class="mb-6 rounded border border-amber-500 p-3 text-sm">{data.locale === 'en' ? 'Structural content awaiting editorial approval.' : 'Conteúdo estrutural a aguardar aprovação editorial.'}</p>}
	<h1 data-tina-field={tinaField(data, 'title')}>{data.title}</h1>
	{data.summary && <p data-tina-field={tinaField(data, 'summary')}>{data.summary}</p>}
	{data.body && <div class="whitespace-pre-line" data-tina-field={tinaField(data, 'body')}>{data.body}</div>}
</article>}
