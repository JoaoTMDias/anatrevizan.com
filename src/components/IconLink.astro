---
import { Icon } from 'astro-icon/components';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	title: string;
	link: string;
	/** Any Iconify icon name, e.g. "tabler:brand-x". */
	icon: string;
};

const { title, link, icon, ...rest } = Astro.props;
const isExternal = /^https?:\/\//i.test(link);
---

<a href={link} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'external noreferrer' : undefined} aria-label={title} title={title} {...rest}>
	<Icon name={icon} aria-hidden="true" />
</a>
