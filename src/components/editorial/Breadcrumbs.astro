---
interface Item {
	label: string;
	href?: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="editorial-breadcrumbs">
	<ol>
		{items.map((item, index) => (
			<li>
				{index > 0 && <span aria-hidden="true">/</span>}
				{item.href ? (
					<a href={item.href}>{item.label}</a>
				) : (
					<span aria-current="page">{item.label}</span>
				)}
			</li>
		))}
	</ol>
</nav>
