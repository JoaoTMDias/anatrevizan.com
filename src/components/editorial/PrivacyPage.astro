---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { LegalPageContent } from '../../lib/page-content';
import DraftNotice from './DraftNotice.astro';
interface Props { data: CmsEditorial }
const { data } = Astro.props;
const page = data.privacyPage as LegalPageContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
---
<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	<header class="border-b bg-slate-100 px-6 py-16"><div class="mx-auto max-w-4xl"><h1 class="text-4xl font-bold md:text-5xl">{data.title}</h1><p class="mt-5">{data.summary}</p></div></header>
	{page && <div class="mx-auto max-w-4xl px-6 py-14" data-tina-field={tinaField(data, 'privacyPage')}><p class="rounded border border-amber-400 bg-amber-50 p-5">{page.sourceStatus}</p><section class="mt-10"><h2 class="text-2xl font-bold">Cobertura necessária antes da publicação</h2><p class="mt-3 text-sm">Lista interna de revisão; não constitui uma política de privacidade.</p><ul class="mt-5 list-disc space-y-2 pl-6">{page.reviewRequirements.map((item) => <li>{item}</li>)}</ul></section>{page.sections?.map((section) => <section class="mt-10"><h2 class="text-2xl font-bold">{section.heading}</h2><div class="mt-4 space-y-4">{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></section>)}</div>}
</article>
