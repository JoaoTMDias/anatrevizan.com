---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { AcademicHubContent } from '../../lib/page-content';
import { pathFor } from '../../lib/routing';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Section from '../ui/Section.astro';
import ContactCta from './ContactCta.astro';
import DraftNotice from './DraftNotice.astro';
import PageHero from './PageHero.astro';

interface Props { data: CmsEditorial }
const { data } = Astro.props;
const hub = data.academicHub as AcademicHubContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
---

<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	{hub ? <>
		<PageHero title={data.title} subtitle={hub.subtitle} locale={locale} data-tina-field={tinaField(data, 'academicHub')} />
		<Section>
			<p class="mb-10 max-w-3xl text-lg leading-relaxed text-muted-foreground">{hub.introText}</p>
			<div class="editorial-grid">
				{hub.sections.map((item) => <Card class:list={['p-6', item.highlight && 'border-l-4 border-l-accent']}>
					<h2 class="text-xl font-semibold">{item.title}</h2>
					<p class="text-sm leading-relaxed text-muted-foreground">{item.description}</p>
					<Button class="mt-auto self-start" variant="link" href={pathFor(item.routeKey, locale)}>{item.cta}</Button>
				</Card>)}
			</div>
		</Section>
		<ContactCta heading={hub.ctaHeading} text={hub.ctaText} locale={locale} />
	</> : <section class="site-container min-h-[60vh] py-20"><h1>{data.title}</h1><p class="mt-4">{data.summary}</p></section>}
</article>
