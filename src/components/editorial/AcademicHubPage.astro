---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { AcademicHubContent } from '../../lib/page-content';
import { pathFor } from '../../lib/routing';
import DraftNotice from './DraftNotice.astro';
interface Props { data: CmsEditorial }
const { data } = Astro.props;
const hub = data.academicHub as AcademicHubContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
---
<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	{hub ? <>
		<header class="bg-slate-900 px-6 py-20 text-white" data-tina-field={tinaField(data, 'academicHub')}><div class="mx-auto max-w-6xl"><h1 class="text-4xl font-bold md:text-6xl">{data.title}</h1><p class="mt-5 max-w-3xl text-lg text-slate-200">{hub.subtitle}</p></div></header>
		<section class="mx-auto max-w-6xl px-6 py-16"><p class="max-w-3xl text-lg">{hub.introText}</p><div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{hub.sections.map((section) => <article class:list={['rounded-lg border p-6', section.highlight && 'border-l-4 border-l-teal-500']}><h2 class="text-xl font-semibold">{section.title}</h2><p class="mt-3 text-sm">{section.description}</p><a class="mt-5 inline-block font-semibold underline" href={pathFor(section.routeKey, locale)}>{section.cta}</a></article>)}</div></section>
		<section class="bg-slate-900 px-6 py-16 text-center text-white"><h2 class="text-3xl font-bold">{hub.ctaHeading}</h2><p class="mx-auto mt-4 max-w-2xl">{hub.ctaText}</p><a class="mt-7 inline-block rounded bg-teal-600 px-5 py-3 font-semibold" href={pathFor('booking', locale)}>Agendar primeiro contacto</a></section>
	</> : <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20"><h1>{data.title}</h1><p class="mt-4">{data.summary}</p></section>}
</article>
