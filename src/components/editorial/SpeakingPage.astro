---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import type { SpeakingPageContent } from "../../lib/page-content";
import { pathFor } from "../../lib/routing";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import ContactCta from "./ContactCta.astro";
import DraftNotice from "./DraftNotice.astro";
import PageHero from "./PageHero.astro";
import SectionHeading from "./SectionHeading.astro";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const speaking = data.speakingPage as SpeakingPageContent | null | undefined;
const locale = data.locale === "en" ? "en" : "pt-PT";
const kitIcons = ["user", "photo", "list-check"];
---

<div id="main-content" tabindex="-1">
  <DraftNotice locale={locale} approvalPending={data.approvalPending} />
  {
    speaking ? (
      <>
        <PageHero
          title={data.title}
          subtitle={speaking.subtitle}
          tag={speaking.tag}
          locale={locale}
          heroMedia={data.media}
          parent={{
            label: locale === "en" ? "Academic" : "Academia",
            href: pathFor("academic", locale),
          }}
          data-tina-field={tinaField(data, "speakingPage")}
        />
        <Section>
          <div class="speaking-bio">
            <>
              <div class="speaking-photo" role="img" aria-label={speaking.photoPlaceholderLabel}>
                <>
                  <Icon name="photo" />
                  <span>{speaking.photoPlaceholderLabel}</span>
                </>
              </div>
              <div>
                <>
                  <SectionHeading title={speaking.bioHeading} />
                  <div class="speaking-bio__text">
                    {speaking.bioParagraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                  <p class="speaking-kit-notice">
                    <Icon name="info-circle" />
                    {speaking.kitDownloadLabel}:{" "}
                    {locale === "en" ? "file not yet available." : "ficheiro ainda não disponível."}
                  </p>
                  <Button class="mt-5" variant="outline" href={pathFor("contact", locale)}>
                    {speaking.inviteCta}
                  </Button>
                </>
              </div>
            </>
          </div>
        </Section>
        <Section background="bg-secondary">
          <>
            <SectionHeading title={speaking.topicsHeading} />
            <ul class="speaking-topics">
              {speaking.topics.map((topic) => (
                <li>{topic}</li>
              ))}
            </ul>
          </>
        </Section>
        <Section>
          <>
            <SectionHeading title={speaking.kitHeading} />
            <ul class="speaking-kit-grid">
              {speaking.kitItems.map((item, index) => (
                <li>
                  <Card class="speaking-kit-card p-6">
                    <span class="academic-icon" aria-hidden="true">
                      <Icon name={kitIcons[index]} />
                    </span>
                    <span>{item}</span>
                  </Card>
                </li>
              ))}
            </ul>
          </>
        </Section>
        <ContactCta heading={speaking.ctaHeading} text={speaking.ctaText} locale={locale} />
      </>
    ) : (
      <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20">
        <>
          <h1>{data.title}</h1>
          <p class="mt-4">{data.summary}</p>
        </>
      </section>
    )
  }
</div>
