---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { SpeakingPageContent } from '../../lib/page-content';
import { pathFor } from '../../lib/routing';
import DraftNotice from './DraftNotice.astro';
interface Props { data: CmsEditorial }
const { data } = Astro.props;
const speaking = data.speakingPage as SpeakingPageContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
---
<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	{speaking ? <>
		<header class="bg-slate-900 px-6 py-20 text-white" data-tina-field={tinaField(data, 'speakingPage')}><div class="mx-auto max-w-6xl"><a class="text-sm underline" href={pathFor('academic', locale)}>Academia</a><p class="mt-5">{speaking.tag}</p><h1 class="mt-3 text-4xl font-bold md:text-6xl">{data.title}</h1><p class="mt-5 max-w-3xl text-lg text-slate-200">{speaking.subtitle}</p></div></header>
		<section class="mx-auto grid max-w-6xl gap-10 px-6 py-16 md:grid-cols-3"><div class="flex aspect-[4/5] items-center justify-center rounded-lg border bg-slate-50 text-center text-sm" role="img" aria-label={speaking.photoPlaceholderLabel}>{speaking.photoPlaceholderLabel}</div><div class="md:col-span-2"><h2 class="text-3xl font-bold">{speaking.bioHeading}</h2><div class="mt-6 space-y-5">{speaking.bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div><p class="mt-7 rounded border border-amber-400 p-3 text-sm">{speaking.kitDownloadLabel}: ficheiro ainda não disponível.</p><a class="mt-5 inline-block font-semibold underline" href={pathFor('contact', locale)}>{speaking.inviteCta}</a></div></section>
		<section class="bg-slate-50 px-6 py-16"><div class="mx-auto max-w-6xl"><h2 class="text-3xl font-bold">{speaking.topicsHeading}</h2><ul class="mt-8 flex flex-wrap gap-3">{speaking.topics.map((topic) => <li class="rounded-full border bg-white px-4 py-2">{topic}</li>)}</ul></div></section>
		<section class="mx-auto max-w-6xl px-6 py-16"><h2 class="text-3xl font-bold">{speaking.kitHeading}</h2><ul class="mt-8 grid gap-6 sm:grid-cols-3">{speaking.kitItems.map((item) => <li class="rounded-lg border p-5">{item}</li>)}</ul></section>
		<section class="bg-slate-900 px-6 py-16 text-center text-white"><h2 class="text-3xl font-bold">{speaking.ctaHeading}</h2><p class="mx-auto mt-4 max-w-2xl">{speaking.ctaText}</p><a class="mt-7 inline-block rounded bg-teal-600 px-5 py-3 font-semibold" href={pathFor('contact', locale)}>{speaking.inviteCta}</a></section>
	</> : <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20"><h1>{data.title}</h1><p class="mt-4">{data.summary}</p></section>}
</article>
