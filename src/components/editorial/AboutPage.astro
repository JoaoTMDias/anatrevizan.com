---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import type { AboutContent } from "../../lib/page-content";
import { pathFor } from "../../lib/routing";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import ContactCta from "./ContactCta.astro";
import PageHero from "./PageHero.astro";
import SectionHeading from "./SectionHeading.astro";
import RichText from "./RichText.astro";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const about = data.about as AboutContent | null | undefined;
const locale = data.locale === "en" ? "en" : "pt-PT";
const valueIcons = ["scale", "award", "users-group", "lock", "heart-handshake", "leaf"];
---

<div id="main-content" tabindex="-1">
  {
    about ? (
      <>
        <PageHero
          title={data.title}
          subtitle={about.subtitle}
          tag={about.tag}
          locale={locale}
          routeKey={data.routeKey}
          heroMedia={data.media}
          data-tina-field={tinaField(data, "about")}
        />
        <Section>
          <RichText content={about.narrative} class="about-narrative max-w-3xl" />
        </Section>
        <Section background="bg-secondary">
          <div class="max-w-3xl">
            <>
              <SectionHeading title={about.milestonesTitle} />
              <ol class="about-timeline">
                {about.milestones.map((item) => (
                  <li>
                    <p>{item.year}</p>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </li>
                ))}
              </ol>
            </>
          </div>
        </Section>
        <Section>
          <>
            <SectionHeading title={about.currentWorkTitle} />
            <div class="about-current-work">
              {about.currentWork.map((item) => (
                <Card as="article" class="p-6">
                  <p class="text-2xl" aria-hidden="true">
                    {item.country}
                  </p>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </Card>
              ))}
            </div>
          </>
        </Section>
        <Section background="bg-secondary">
          <>
            <SectionHeading title={about.valuesTitle} subtitle={about.valuesSubtitle} />
            <div class="about-values">
              {about.values.map((item, index) => (
                <article>
                  <span>
                    <Icon name={valueIcons[index]} />
                  </span>
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </>
        </Section>
        <Section class="about-networks">
          <>
            <h2>{about.networksLabel}</h2>
            <ul>
              {about.networks.map((network) => (
                <li>{network}</li>
              ))}
            </ul>
            <Button class="mt-8" variant="outline" href={pathFor("speaking", locale)}>
              {about.speakerKitCta}
            </Button>
          </>
        </Section>
        <ContactCta heading={about.finalCtaHeading} text={about.finalCtaText} locale={locale} />
      </>
    ) : (
      <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20">
        <>
          <h1>{data.title}</h1>
          <p class="mt-4">{data.summary}</p>
        </>
      </section>
    )
  }
</div>
