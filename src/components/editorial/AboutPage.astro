---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import type { AboutContent } from "../../lib/page-content";
import { pathFor } from "../../lib/routing";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import ContactCta from "./ContactCta.astro";
import AcronymText from "./AcronymText.astro";
import EditorialImage from "./EditorialImage.astro";
import PageHero from "./PageHero.astro";
import SectionHeading from "./SectionHeading.astro";
import RichText from "./RichText.astro";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const about = data.about as AboutContent | null | undefined;
const locale = data.locale === "en" ? "en" : "pt-PT";
const valueIcons = ["scale", "award", "users-group", "lock", "heart-handshake", "leaf"];
---

<div id="main-content" tabindex="-1">
  {
    about ? (
      <>
        <PageHero
          title={data.title}
          subtitle={about.subtitle}
          tag={about.tag}
          locale={locale}
          routeKey={data.routeKey}
          heroMedia={data.media}
          data-tina-field={tinaField(data, "about")}
        />
        <Section>
          <div class:list={["editorial-intro", !about.introImage?.image && "editorial-intro--text-only"]}>
            {about.introImage?.image && (
              <figure class="editorial-intro__media" data-tina-field={tinaField(data, "about")}>
                <EditorialImage
                  src={about.introImage.image}
                  alt={about.introImage.decorative ? "" : (about.introImage.alt?.trim() ?? "")}
                  width={960}
                  height={720}
                  loading="lazy"
                  decoding="async"
                  sizes="(min-width: 1024px) 50vw, 100vw"
                />
              </figure>
            )}
            <RichText content={about.narrative} locale={locale} class="about-narrative editorial-intro__copy" />
          </div>
        </Section>
        <Section background="bg-secondary">
          <div class="max-w-3xl">
            <>
              <SectionHeading title={about.milestonesTitle} locale={locale} />
              <ol class="about-timeline">
                {about.milestones.map((item) => (
                  <li class="about-timeline__item">
                    <p>{item.year}</p>
                    <h3><AcronymText text={item.title} locale={locale} /></h3>
                    <p><AcronymText text={item.description} locale={locale} /></p>
                  </li>
                ))}
              </ol>
            </>
          </div>
        </Section>
        <Section>
          <>
            <SectionHeading title={about.currentWorkTitle} locale={locale} />
            <div class="about-current-work">
              {about.currentWork.map((item) => (
                <Card as="article" class="p-6">
                  <p class="text-2xl" aria-hidden="true">
                    {item.country}
                  </p>
                  <h3><AcronymText text={item.title} locale={locale} /></h3>
                  <p><AcronymText text={item.description} locale={locale} /></p>
                </Card>
              ))}
            </div>
          </>
        </Section>
        <Section background="bg-secondary">
          <>
            <SectionHeading title={about.valuesTitle} subtitle={about.valuesSubtitle} locale={locale} />
            <div class="about-values">
              {about.values.map((item, index) => (
                <article>
                  <span>
                    <Icon name={valueIcons[index]} />
                  </span>
                  <div>
                    <h3><AcronymText text={item.title} locale={locale} /></h3>
                    <p><AcronymText text={item.description} locale={locale} /></p>
                  </div>
                </article>
              ))}
            </div>
          </>
        </Section>
        <Section class="about-networks">
          <>
            <h2>{about.networksLabel}</h2>
            <ul>
              {about.networks.map((network) => (
                <li><AcronymText text={network} locale={locale} /></li>
              ))}
            </ul>
            <Button class="mt-8" variant="outline" href={`${pathFor("events", locale)}#speaker-kit`}>
              {about.speakerKitCta}
            </Button>
          </>
        </Section>
        <ContactCta heading={about.finalCtaHeading} text={about.finalCtaText} locale={locale} />
      </>
    ) : (
      <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20">
        <>
          <h1>{data.title}</h1>
          <p class="mt-4">{data.summary}</p>
        </>
      </section>
    )
  }
</div>
