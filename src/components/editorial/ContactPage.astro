---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { ContactPageContent } from '../../lib/page-content';
import { pathFor } from '../../lib/routing';
import DraftNotice from './DraftNotice.astro';
interface Props { data: CmsEditorial }
const { data } = Astro.props;
const contact = data.contactPage as ContactPageContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
---
<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	{contact ? <>
		<header class="bg-slate-900 px-6 py-20 text-white" data-tina-field={tinaField(data, 'contactPage')}><div class="mx-auto max-w-6xl"><p>{contact.tag}</p><h1 class="mt-3 text-4xl font-bold md:text-6xl">{data.title}</h1><p class="mt-5 max-w-3xl text-lg text-slate-200">{contact.subtitle}</p></div></header>
		<section class="mx-auto grid max-w-6xl gap-10 px-6 py-16 lg:grid-cols-3">
			<div class="lg:col-span-2">
				<h2 class="text-3xl font-bold">Formulário de contacto</h2>
				<p class="mt-4 rounded border border-amber-400 bg-amber-50 p-4">O formulário encontra-se preparado editorialmente, mas o envio seguro será ativado numa fase posterior.</p>
				<dl class="mt-8 grid gap-5 sm:grid-cols-2">
					{[
						contact.formCopy.nameLabel,
						contact.formCopy.whatsappLabel,
						contact.formCopy.emailLabel,
						contact.formCopy.countryLabel,
						contact.formCopy.subjectLabel,
					].map((label) => <div class="rounded border p-4"><dt class="font-semibold">{label}</dt><dd class="mt-2 text-sm text-slate-600">Campo previsto; submissão ainda indisponível.</dd></div>)}
				</dl>
				<p class="mt-6 text-sm">{contact.formCopy.consentText} <a class="underline" href={pathFor('privacy', locale)}>{contact.formCopy.privacyPolicyLabel}</a>.</p>
			</div>
			<aside class="rounded border bg-slate-50 p-6"><h2 class="text-xl font-semibold">{contact.otherMethodsHeading}</h2><ul class="mt-5 space-y-4">{contact.contactMethods.map((method) => <li><strong>{method.label}</strong>{method.value && <span class="block break-all text-sm">{method.value}</span>}<span class="block text-xs text-slate-500">Destino ainda não confirmado.</span></li>)}</ul><hr class="my-6"/><p>{contact.countriesLabel}</p><p class="mt-2">{contact.languagesLabel}</p><a class="mt-6 inline-block rounded bg-teal-700 px-5 py-3 font-semibold text-white" href={pathFor('booking', locale)}>{contact.bookingCta}</a></aside>
		</section>
	</> : <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20"><h1>{data.title}</h1><p class="mt-4">{data.summary}</p></section>}
</article>
