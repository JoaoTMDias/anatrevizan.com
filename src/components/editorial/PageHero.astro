---
import type { HTMLAttributes } from "astro/types";
import { heroAspectRatioForRoute, heroFocalPoint, type HeroMedia } from "../../lib/hero-media";
import { pathFor, type PublishedLocale, type RouteKey } from "../../lib/routing";
import { responsiveCssImage, responsiveSrcSet } from "../../lib/media-pipeline";
import Button from "../ui/Button.astro";
import Breadcrumbs from "./Breadcrumbs.astro";

interface Props extends Omit<HTMLAttributes<"header">, "title"> {
  title: string;
  subtitle?: string;
  tag?: string;
  locale: PublishedLocale;
  routeKey: RouteKey;
  parent?: { label: string; href: string };
  tone?: "accent" | "primary";
  heroMedia?: HeroMedia | null;
  showActions?: boolean;
}

const {
  title,
  subtitle,
  tag,
  locale,
  routeKey,
  parent,
  tone = "primary",
  heroMedia,
  showActions = false,
  class: className,
  ...rest
} = Astro.props;
const backgroundImage = heroMedia?.background?.image;
const backgroundPosition = heroFocalPoint(heroMedia?.background?.focalPoint);
const foreground = heroMedia?.foreground?.image ? heroMedia.foreground : null;
const foregroundRatio = heroAspectRatioForRoute(routeKey);
const items = [
  { label: locale === "en" ? "Home" : "Início", href: pathFor("home", locale) },
  ...(parent ? [parent] : []),
  { label: title },
];
---

<div
  class:list={[
    "editorial-hero",
    tone === "accent" && "editorial-hero--accent",
    backgroundImage && "editorial-hero--media",
    foreground && "editorial-hero--with-foreground",
    className,
  ]}
  style={backgroundImage
    ? `--hero-image: ${responsiveCssImage(backgroundImage)}; --hero-position: center ${backgroundPosition};`
    : undefined}
  {...rest}
>
  <div class="editorial-hero__overlay"></div>
  <div class="site-container editorial-hero__inner">
    <Breadcrumbs items={items} />
    <div class="editorial-hero__content">
      <div class="editorial-hero__copy">
        {tag && <p class="editorial-eyebrow">{tag}</p>}
        <h1>{title}</h1>
        {subtitle && <p class="editorial-hero__subtitle">{subtitle}</p>}
        {
          showActions && (
            <div class="mt-8 flex flex-wrap gap-4">
              <Button variant="accent" href={pathFor("booking", locale)}>
                {locale === "en" ? "Book an initial call" : "Agendar contacto"}
              </Button>
              <Button variant="outlineInverse" href={pathFor("contact", locale)}>
                {locale === "en" ? "Discuss my case" : "Falar sobre o meu caso"}
              </Button>
            </div>
          )
        }
      </div>
      {
        foreground && (
          <figure
            class:list={[
              "editorial-hero__foreground",
              `editorial-hero__foreground--${foregroundRatio}`,
            ]}
          >
            <img
              src={foreground.image ?? undefined}
              srcset={responsiveSrcSet(foreground.image)}
              alt={foreground.decorative ? "" : (foreground.alt?.trim() ?? "")}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              sizes="(min-width: 1024px) min(40vw, 32rem), calc(100vw - 2.5rem)"
            />
          </figure>
        )
      }
    </div>
  </div>
</div>
