---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import type { LegalPageContent } from "../../lib/page-content";
import LegalDates from "./LegalDates.astro";
import RichText from "./RichText.astro";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const page = data.cookiesPage as LegalPageContent | null | undefined;
const effectiveDate = (data.legal as { effectiveDate?: string | null } | null)?.effectiveDate;
---

<div id="main-content" tabindex="-1">
  <div class="legal-header">
    <div class="site-container"><h1>{data.title}</h1><p>{data.summary}</p><LegalDates locale={data.locale} effectiveDate={effectiveDate} lastModified={data.lastModified} /></div>
  </div>
  {
    page && (
      <div class="legal-content site-container" data-tina-field={tinaField(data, "cookiesPage")}>
        <section>
          <>
            <h2>Cobertura necessária antes da publicação</h2>
            <p>Lista interna de revisão; não constitui uma política de cookies.</p>
            <ul>
              {page.reviewRequirements.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        </section>
        {page.sections?.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <RichText content={section.paragraphs} />
          </section>
        ))}
      </div>
    )
  }
</div>
