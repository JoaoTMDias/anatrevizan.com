---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import type { LegalPageContent } from "../../lib/page-content";
import DraftNotice from "./DraftNotice.astro";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const page = data.cookiesPage as LegalPageContent | null | undefined;
const locale = data.locale === "en" ? "en" : "pt-PT";
---

<div id="main-content" tabindex="-1">
  <DraftNotice locale={locale} approvalPending={data.approvalPending} />
  <div class="legal-header">
    <div class="site-container"><h1>{data.title}</h1><p>{data.summary}</p></div>
  </div>
  {
    page && (
      <div class="legal-content site-container" data-tina-field={tinaField(data, "cookiesPage")}>
        <section>
          <>
            <h2>Cobertura necessária antes da publicação</h2>
            <p>Lista interna de revisão; não constitui uma política de cookies.</p>
            <ul>
              {page.reviewRequirements.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        </section>
        {page.sections?.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <div>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</div>
