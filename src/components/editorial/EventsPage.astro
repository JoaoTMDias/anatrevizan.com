---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { EventsPageContent } from '../../lib/page-content';
import { pathFor } from '../../lib/routing';
import Section from '../ui/Section.astro';
import ContactCta from './ContactCta.astro';
import DraftNotice from './DraftNotice.astro';
import EmptyState from './EmptyState.astro';
import PageHero from './PageHero.astro';
interface Props { data: CmsEditorial }
const { data } = Astro.props;
const events = data.eventsPage as EventsPageContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
---
<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	{events ? <>
		<PageHero title={data.title} subtitle={events.subtitle} tag={events.tag} locale={locale} parent={{ label: 'Academia', href: pathFor('academic', locale) }} data-tina-field={tinaField(data, 'eventsPage')} />
		<Section class="max-w-5xl">{events.entries?.length ? <ol class="space-y-8">{events.entries.map((entry) => <li><article><p class="text-sm text-muted-foreground">{entry.date} · {entry.city}, {entry.country}</p><h2 class="mt-2 text-xl font-semibold">{entry.event}</h2><p class="mt-2">{entry.institution}</p>{entry.url && <a class="site-link mt-3 inline-block" href={entry.url} rel="external">Ver evento</a>}</article></li>)}</ol> : <EmptyState heading={events.emptyHeading} text={events.emptyText} href={pathFor('speaking', locale)} linkLabel={events.speakerKitCta} />}</Section>
		<ContactCta heading={events.ctaHeading} text={events.ctaText} locale={locale} />
	</> : <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20"><h1>{data.title}</h1><p class="mt-4">{data.summary}</p></section>}
</article>
