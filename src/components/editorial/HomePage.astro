---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import type { HomeContent } from "../../lib/page-content";
import { hasValidRouteKey } from "../../lib/page-content";
import { getPublications } from "../../lib/publication-content";
import { selectHomePublications } from "../../lib/publications";
import { pathFor } from "../../lib/routing";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import ContactCta from "./ContactCta.astro";
import DraftNotice from "./DraftNotice.astro";
import SectionHeading from "./SectionHeading.astro";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const home = data.home as HomeContent | null | undefined;
const locale = data.locale === "en" ? "en" : "pt-PT";
const destination = (item: { routeKey?: unknown }) =>
  hasValidRouteKey(item) ? pathFor(item.routeKey, locale) : undefined;
const brandIcons = ["scale", "leaf", "school", "world"];
const differenceIcons = ["world", "microscope", "language", "arrows-exchange"];
const serviceIcons = ["plane-departure", "scale", "leaf", "building-community", "file-description"];
const featuredPublications = home ? selectHomePublications(await getPublications()) : [];
---

<div id="main-content" tabindex="-1">
  <DraftNotice locale={locale} approvalPending={data.approvalPending} />
  {
    home ? (
      <>
        <header class="home-hero" data-tina-field={tinaField(data, "home")}>
          <div class="site-container home-hero__inner">
            <ul
              class="home-brand-words"
              aria-label={locale === "en" ? "Brand values" : "Valores da marca"}
            >
              {home.hero.brandWords.map((word, index) => (
                <li>
                  <Icon name={brandIcons[index]} />
                  {word}
                </li>
              ))}
            </ul>
            <h1>{home.hero.heading}</h1>
            <p>{home.hero.subtitle}</p>
            <div class="home-hero__actions">
              <>
                <Button size="lg" variant="accent" href={pathFor("booking", locale)}>
                  {home.hero.primaryCta}
                </Button>
                <Button size="lg" variant="outlineInverse" href={pathFor("consulting", locale)}>
                  {home.hero.secondaryCta}
                </Button>
              </>
            </div>
          </div>
        </header>
        <Section>
          <div class="home-gateways" aria-label={locale === "en" ? "Areas" : "Áreas"}>
            {home.gateways.map(
              (item, index) =>
                destination(item) && (
                  <a
                    class:list={["home-gateway", index === 1 && "home-gateway--accent"]}
                    href={destination(item)}
                  >
                    <span class="home-gateway__icon">
                      <Icon name={index === 0 ? "scale" : "book-2"} />
                    </span>
                    <div>
                      <h2>{item.title}</h2>
                      <p class="home-gateway__eyebrow">{item.eyebrow}</p>
                    </div>
                    <p class="home-gateway__description">{item.description}</p>
                    <span class="home-gateway__cta">
                      {item.cta}
                      <Icon name="arrow-right" />
                    </span>
                  </a>
                )
            )}
          </div>
        </Section>
        <Section background="bg-secondary">
          <>
            <SectionHeading
              title={home.differencesTitle}
              subtitle={home.differencesSubtitle}
              centered
            />
            <div class="home-differences">
              {home.differences.map((item, index) => (
                <Card as="article" class="home-difference p-6 md:p-8">
                  <span class="home-difference__icon">
                    <Icon name={differenceIcons[index]} />
                  </span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </Card>
              ))}
            </div>
          </>
        </Section>
        <Section>
          <>
            <SectionHeading title={home.servicesTitle} subtitle={home.servicesSubtitle} centered />
            <div class="home-services">
              {home.services.map(
                (item, index) =>
                  destination(item) && (
                    <a class="home-service-card" href={destination(item)}>
                      <span class="home-service-card__heading">
                        <span class="home-service-card__icon">
                          <Icon name={serviceIcons[index]} />
                        </span>
                        <span>{item.tag}</span>
                      </span>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                      <span class="home-service-card__cta">
                        {item.cta}
                        <Icon name="arrow-right" />
                      </span>
                    </a>
                  )
              )}
            </div>
          </>
        </Section>
        <Section background="bg-secondary">
          <div class="home-academic-heading">
            <SectionHeading title={home.academicTitle} subtitle={home.academicSubtitle} />
            <div>
              <Button variant="secondary" size="sm" href={pathFor("publications", locale)}>
                {home.publicationsCta}
              </Button>
              <Button variant="outlineBlack" size="sm" href={pathFor("speaking", locale)}>
                {home.speakerKitCta}
              </Button>
            </div>
          </div>
          <div class="home-publications">
            {featuredPublications.map((publication) => (
              <Card as="article" class="home-publication p-6 md:p-8 gap-2">
                {publication.highlight && <strong>{publication.highlight}</strong>}
                <p class="text-xs text-muted-foreground">
                  {[publication.year, publication.language].filter(Boolean).join(" · ")}
                </p>
                <h3 class="font-heading font-semibold text-foreground-900 leading-snug">
                  {publication.title}
                </h3>
                {publication.journal && (
                  <p class="text-base text-muted-foreground flex-1">{publication.journal}</p>
                )}
                {publication.url && (
                  <a
                    href={publication.url}
                    class="inline-flex items-center gap-1 text-base font-medium text-accent-500 hover:text-accent-600"
                    target="_blank"
                    rel="external noopener noreferrer"
                  >
                    {locale === "en" ? "View publication" : "Ver publicação"}
                    <Icon name="external-link" />
                  </a>
                )}
              </Card>
            ))}
          </div>
        </Section>
        <section class="home-credentials">
          <div class="site-container">
            <h2 class="text-xs text-muted-foreground text-center uppercase tracking-widest">
              {home.credentialsLabel}
            </h2>
            <ul class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-base text-foreground-700 text-center max-w-4xl mx-auto leading-relaxed">
              {home.credentials.map((credential) => (
                <li>
                  <Icon name="circle-check" />
                  {credential}
                </li>
              ))}
            </ul>
          </div>
        </section>
        <ContactCta
          heading={home.finalCtaHeading}
          text={home.finalCtaText}
          locale={locale}
          showContactLink={false}
        />
      </>
    ) : (
      <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20">
        <>
          <h1>{data.title}</h1>
          <p class="mt-4">{data.summary}</p>
        </>
      </section>
    )
  }
</div>
