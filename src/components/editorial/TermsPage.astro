---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import type { LegalPageContent } from "../../lib/page-content";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const page = data.termsPage as LegalPageContent | null | undefined;
---

<div id="main-content" tabindex="-1">
  <div class="legal-header">
    <div class="site-container"><h1>{data.title}</h1><p>{data.summary}</p></div>
  </div>
  {
    page && (
      <div class="legal-content site-container" data-tina-field={tinaField(data, "termsPage")}>
        <section>
          <>
            <h2>Cobertura necessária antes da publicação</h2>
            <p>Lista interna de revisão; não constitui termos de utilização.</p>
            <ul>
              {page.reviewRequirements.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </>
        </section>
        {page.sections?.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <div>
              {section.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</div>
