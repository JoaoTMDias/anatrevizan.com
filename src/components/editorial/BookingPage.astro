---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import { getConfig } from "../../lib/data";
import { safeCalendlyUrl } from "../../lib/external-url";
import type { BookingPageContent } from "../../lib/page-content";
import { pathFor } from "../../lib/routing";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import PageHero from "./PageHero.astro";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const booking = data.bookingPage as BookingPageContent | null | undefined;
const locale = data.locale === "en" ? "en" : "pt-PT";
const config = booking ? (await getConfig()).data.config : null;
const calendlyUrl = safeCalendlyUrl(config?.contacts?.calendlyUrl);
---

<div id="main-content" tabindex="-1">
  {
    booking ? (
      <>
        <PageHero
          title={data.title}
          subtitle={booking.subtitle}
          tag={booking.tag}
          locale={locale}
          heroMedia={data.media}
          data-tina-field={tinaField(data, "bookingPage")}
        />
        <Section class="booking-layout">
          <div>
            {calendlyUrl ? (
              <div class="booking-panel">
                <span class="booking-panel__icon">
                  <Icon name="calendar-event" />
                </span>
                <p>
                  {locale === "en"
                    ? "Booking opens on Calendly, an external service."
                    : "O agendamento é feito usando o Calendly, um serviço externo."}
                </p>
                <Button size="lg" href={calendlyUrl} rel="external noreferrer">
                  {locale === "en" ? "Open booking calendar" : "Abrir calendário de agendamento"}
                  <Icon name="external-link" />
                </Button>
              </div>
            ) : (
              <div class="booking-panel booking-panel--notice">
                <span class="booking-panel__icon">
                  <Icon name="calendar-off" />
                </span>
                <p>
                  {locale === "en"
                    ? "The booking link is not yet configured."
                    : "A ligação de agendamento ainda não está configurada."}
                </p>
                <Button variant="link" href={pathFor("contact", locale)}>
                  {locale === "en" ? "Use the contact page" : "Usar a página de contacto"}
                </Button>
              </div>
            )}
          </div>
          <aside class="booking-notes">
            <>
              <Card class="p-6 gap-2">
                <div class="flex flex-row items-center gap-2">
                  <Icon name="clock" />
                  <h2>{booking.duration}</h2>
                </div>
                <p>{booking.validFor}</p>
              </Card>
              <Card class="p-6">
                <div class="flex flex-row items-center gap-2">
                  <Icon name="world" />
                  <h2>{booking.timezone}</h2>
                </div>
                <p>{booking.timezoneNote}</p>
              </Card>
            </>
          </aside>
        </Section>
      </>
    ) : (
      <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20">
        <>
          <h1>{data.title}</h1>
          <p class="mt-4">{data.summary}</p>
        </>
      </section>
    )
  }
</div>
