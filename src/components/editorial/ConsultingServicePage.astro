---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { ConsultingServiceContent } from '../../lib/page-content';
import { isRouteKey, pathFor } from '../../lib/routing';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import Section from '../ui/Section.astro';
import ContactCta from './ContactCta.astro';
import DraftNotice from './DraftNotice.astro';
import PageHero from './PageHero.astro';
import SectionHeading from './SectionHeading.astro';

interface Props { data: CmsEditorial }
const { data } = Astro.props;
const service = data.consultingService as ConsultingServiceContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
const crosslink = service?.crosslinkRouteKey && isRouteKey(service.crosslinkRouteKey)
	? pathFor(service.crosslinkRouteKey, locale)
	: undefined;
const accent = data.routeKey === 'environmental-esg';
---

<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	{service ? <>
		<PageHero title={data.title} subtitle={service.subtitle} tag={service.tag} locale={locale} tone={accent ? 'accent' : 'primary'} parent={{ label: locale === 'en' ? 'Consulting' : 'Consultoria', href: pathFor('consulting', locale) }} data-tina-field={tinaField(data, 'consultingService')} />
		<Section class="max-w-4xl">
			<SectionHeading title={service.introHeading} />
			<div class="space-y-5 text-lg leading-relaxed text-muted-foreground">{service.introParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
		</Section>
		<Section background="bg-secondary">
			<SectionHeading title={service.servicesHeading} subtitle={service.servicesSubtitle} />
			<div class="editorial-grid">{service.services.map((item) => <Card as="article" class:list={['consulting-card p-6', accent && 'consulting-card--accent']}>
					<h3 class="text-lg font-semibold">{item.title}</h3>
					{item.description && <p class="text-sm leading-relaxed text-muted-foreground">{item.description}</p>}
					{item.items && <ul class="list-disc space-y-2 pl-5 text-sm text-muted-foreground">{item.items.map((entry) => <li>{entry}</li>)}</ul>}
				</Card>)}</div>
		</Section>
		{service.steps?.length && service.stepsHeading && <Section>
			<SectionHeading title={service.stepsHeading} subtitle={service.stepsSubtitle} />
			<ol class="consulting-steps">{service.steps.map((step) => <li><p class:list={['consulting-step__number', accent && 'consulting-step__number--accent']}>{step.number}</p><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
		</Section>}
		{service.differentiatorHeading && <Section class="max-w-4xl">
			<SectionHeading title={service.differentiatorHeading} eyebrow={service.differentiatorEyebrow} />
			<div class="space-y-5 leading-relaxed text-muted-foreground">{service.differentiatorParagraphs?.map((paragraph) => <p>{paragraph}</p>)}</div>
			{service.differentiatorCredentials?.length && <ul class="mt-7 grid gap-3 sm:grid-cols-2">{service.differentiatorCredentials.map((credential) => <li class="rounded-md border bg-card p-4 text-sm">{credential}</li>)}</ul>}
		</Section>}
		{service.relatedWorkHeading && <Section background="bg-secondary">
			<SectionHeading title={service.relatedWorkHeading} subtitle={service.relatedWorkSubtitle} />
			<div class="grid gap-6 md:grid-cols-2">{service.relatedPublications?.map((publication) => <Card as="article" class="p-6">{publication.highlight && <p class="editorial-eyebrow text-primary">{publication.highlight}</p>}<h3 class="text-lg font-semibold">{publication.title}</h3><p class="text-sm text-muted-foreground">{publication.publication}</p></Card>)}</div>
		</Section>}
		{service.crosslinkHeading && crosslink && <aside class="border-y bg-card"><div class="site-container max-w-4xl py-12"><h2 class="text-2xl font-bold">{service.crosslinkHeading}</h2><p class="mt-3 max-w-2xl text-muted-foreground">{service.crosslinkText}</p><Button class="mt-5" variant="link" href={crosslink}>{locale === 'en' ? 'Legal consulting' : 'Consultoria Jurídica'}</Button></div></aside>}
		{service.note && <aside class="border-b"><div class="site-container max-w-4xl py-8"><p class="border-l-4 border-primary pl-4 text-sm leading-relaxed text-muted-foreground">{service.note}</p></div></aside>}
		<ContactCta heading={service.ctaHeading} text={service.ctaText} locale={locale} />
	</> : <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20"><h1>{data.title}</h1><p class="mt-4">{data.summary}</p></section>}
</article>
