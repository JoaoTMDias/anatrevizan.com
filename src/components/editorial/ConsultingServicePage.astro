---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { ConsultingServiceContent } from '../../lib/page-content';
import { isRouteKey, pathFor } from '../../lib/routing';
import DraftNotice from './DraftNotice.astro';

interface Props { data: CmsEditorial }
const { data } = Astro.props;
const service = data.consultingService as ConsultingServiceContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
const crosslink = service?.crosslinkRouteKey && isRouteKey(service.crosslinkRouteKey)
	? pathFor(service.crosslinkRouteKey, locale)
	: undefined;
---

<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	{service ? <>
		<header class="bg-slate-900 px-6 py-20 text-white" data-tina-field={tinaField(data, 'consultingService')}>
			<div class="mx-auto max-w-6xl">
				<a class="text-sm underline" href={pathFor('consulting', locale)}>Consultoria</a>
				<p class="mt-5">{service.tag}</p>
				<h1 class="mt-3 text-4xl font-bold md:text-6xl">{data.title}</h1>
				<p class="mt-5 max-w-3xl text-lg text-slate-200">{service.subtitle}</p>
			</div>
		</header>
		<section class="mx-auto max-w-4xl px-6 py-16">
			<h2 class="text-3xl font-bold">{service.introHeading}</h2>
			<div class="mt-6 space-y-5 text-lg">{service.introParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div>
		</section>
		<section class="bg-slate-50 px-6 py-16">
			<div class="mx-auto max-w-6xl">
				<h2 class="text-3xl font-bold">{service.servicesHeading}</h2>
				{service.servicesSubtitle && <p class="mt-3 max-w-3xl">{service.servicesSubtitle}</p>}
				<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{service.services.map((item) => <article class="rounded-lg border bg-white p-5">
					<h3 class="text-lg font-semibold">{item.title}</h3>
					{item.description && <p class="mt-3 text-sm">{item.description}</p>}
					{item.items && <ul class="mt-3 list-disc space-y-2 pl-5 text-sm">{item.items.map((entry) => <li>{entry}</li>)}</ul>}
				</article>)}</div>
			</div>
		</section>
		{service.steps?.length && service.stepsHeading && <section class="mx-auto max-w-6xl px-6 py-16">
			<h2 class="text-3xl font-bold">{service.stepsHeading}</h2>
			{service.stepsSubtitle && <p class="mt-3">{service.stepsSubtitle}</p>}
			<ol class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-4">{service.steps.map((step) => <li><p class="text-sm font-semibold">{step.number}</p><h3 class="mt-2 font-semibold">{step.title}</h3><p class="mt-2 text-sm">{step.description}</p></li>)}</ol>
		</section>}
		{service.differentiatorHeading && <section class="mx-auto max-w-4xl px-6 py-16">
			{service.differentiatorEyebrow && <p class="text-sm font-semibold uppercase">{service.differentiatorEyebrow}</p>}
			<h2 class="mt-3 text-3xl font-bold">{service.differentiatorHeading}</h2>
			<div class="mt-6 space-y-5">{service.differentiatorParagraphs?.map((paragraph) => <p>{paragraph}</p>)}</div>
			{service.differentiatorCredentials?.length && <ul class="mt-7 list-disc space-y-2 pl-5">{service.differentiatorCredentials.map((credential) => <li>{credential}</li>)}</ul>}
		</section>}
		{service.relatedWorkHeading && <section class="bg-slate-50 px-6 py-16"><div class="mx-auto max-w-6xl">
			<h2 class="text-3xl font-bold">{service.relatedWorkHeading}</h2>
			{service.relatedWorkSubtitle && <p class="mt-3">{service.relatedWorkSubtitle}</p>}
			<div class="mt-8 grid gap-6 md:grid-cols-2">{service.relatedPublications?.map((publication) => <article class="rounded-lg border bg-white p-5">{publication.highlight && <p class="text-sm font-semibold">{publication.highlight}</p>}<h3 class="mt-2 font-semibold">{publication.title}</h3><p class="mt-2 text-sm">{publication.publication}</p></article>)}</div>
		</div></section>}
		{service.crosslinkHeading && crosslink && <aside class="mx-auto max-w-4xl px-6 py-12"><h2 class="text-2xl font-bold">{service.crosslinkHeading}</h2><p class="mt-3">{service.crosslinkText}</p><a class="mt-4 inline-block font-semibold underline" href={crosslink}>Consultoria Jurídica</a></aside>}
		{service.note && <aside class="mx-auto max-w-4xl px-6 py-8"><p class="border-l-4 border-amber-500 pl-4 text-sm">{service.note}</p></aside>}
		<section class="bg-slate-900 px-6 py-16 text-center text-white"><h2 class="text-3xl font-bold">{service.ctaHeading}</h2><p class="mx-auto mt-4 max-w-2xl">{service.ctaText}</p><a class="mt-7 inline-block rounded bg-teal-600 px-5 py-3 font-semibold" href={pathFor('booking', locale)}>Agendar primeiro contacto</a></section>
	</> : <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20"><h1>{data.title}</h1><p class="mt-4">{data.summary}</p></section>}
</article>
