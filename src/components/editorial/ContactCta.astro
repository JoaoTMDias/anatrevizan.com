---
import { pathFor, type PublishedLocale } from '../../lib/routing';
import Button from '../ui/Button.astro';

interface Props {
	heading: string;
	text: string;
	locale: PublishedLocale;
}

const { heading, text, locale } = Astro.props;
---

<section class="editorial-cta" aria-labelledby="editorial-cta-heading">
	<div class="site-container text-center">
		<h2 id="editorial-cta-heading">{heading}</h2>
		<p>{text}</p>
		<div class="editorial-cta__actions">
			<Button href={pathFor('booking', locale)} size="lg">
				{locale === 'en' ? 'Schedule a first conversation' : 'Agendar primeiro contacto'}
			</Button>
			<Button href={pathFor('contact', locale)} variant="outline" size="lg" class="editorial-cta__secondary">
				{locale === 'en' ? 'Contact me' : 'Entrar em contacto'}
			</Button>
		</div>
	</div>
</section>
