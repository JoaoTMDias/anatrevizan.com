---
import { pathFor, type PublishedLocale } from '../../lib/routing';
import Button from '../ui/Button.astro';

interface Props {
	heading: string;
	text: string;
	locale: PublishedLocale;
	showContactLink?: boolean;
}

const { heading, text, locale, showContactLink = true } = Astro.props;
---

<section class="editorial-cta" aria-labelledby="editorial-cta-heading">
	<div class="site-container text-center">
		<h2 id="editorial-cta-heading">{heading}</h2>
		<p>{text}</p>
		<div class="editorial-cta__actions">
			<Button href={pathFor('booking', locale)} variant="accent" size="lg">
				{locale === 'en' ? 'Schedule a first conversation' : 'Agendar primeiro contacto'}
			</Button>
			{showContactLink && <Button href={pathFor('contact', locale)} variant="outlineInverse" size="lg">
				{locale === 'en' ? 'Contact me' : 'Falar sobre o meu caso'}
			</Button>}
		</div>
	</div>
</section>
