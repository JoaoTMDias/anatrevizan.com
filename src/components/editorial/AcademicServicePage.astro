---
import { tinaField } from "@tinacms/astro/tina-field";
import type { CmsEditorial } from "../../lib/data";
import type { AcademicServiceContent } from "../../lib/page-content";
import { pathFor } from "../../lib/routing";
import Card from "../ui/Card.astro";
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import ContactCta from "./ContactCta.astro";
import PageHero from "./PageHero.astro";
import SectionHeading from "./SectionHeading.astro";
import RichText from "./RichText.astro";
interface Props {
  data: CmsEditorial;
}
const { data } = Astro.props;
const service = data.academicService as AcademicServiceContent | null | undefined;
const locale = data.locale === "en" ? "en" : "pt-PT";
const icons =
  data.routeKey === "training"
    ? ["leaf", "chart-bar", "world", "shield-check", "flag", "plane-departure"]
    : ["file-pencil", "affiliate", "layout-2", "compass", "writing", "world"];
---

<div id="main-content" tabindex="-1">
  {
    service ? (
      <>
        <PageHero
          title={data.title}
          subtitle={service.subtitle}
          locale={locale}
          heroMedia={data.media}
          parent={{ label: "Academia", href: pathFor("academic", locale) }}
          data-tina-field={tinaField(data, "academicService")}
        />
        <Section class="max-w-4xl">
          <>
            <SectionHeading title={service.introHeading} />
            <RichText content={service.introParagraphs} class="space-y-5 text-lg leading-relaxed text-muted-foreground" />
          </>
        </Section>
        <Section background="bg-secondary">
          <>
            <SectionHeading title={service.servicesHeading} subtitle={service.servicesSubtitle} />
            <div class="editorial-grid">
              {service.services.map((item, index) => (
                <Card as="article" class="academic-service-card p-6 md:p-8">
                  <span class="academic-icon" aria-hidden="true">
                    <Icon name={icons[index]} />
                  </span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </Card>
              ))}
            </div>
          </>
        </Section>
        <aside class="border-y">
          <div class="site-container py-8">
            <p class="max-w-3xl text-base leading-relaxed text-muted-foreground">{service.note}</p>
          </div>
        </aside>
        <ContactCta heading={service.ctaHeading} text={service.ctaText} locale={locale} />
      </>
    ) : (
      <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20">
        <>
          <h1>{data.title}</h1>
          <p class="mt-4">{data.summary}</p>
        </>
      </section>
    )
  }
</div>
