---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsEditorial } from '../../lib/data';
import type { AcademicServiceContent } from '../../lib/page-content';
import { pathFor } from '../../lib/routing';
import DraftNotice from './DraftNotice.astro';
interface Props { data: CmsEditorial }
const { data } = Astro.props;
const service = data.academicService as AcademicServiceContent | null | undefined;
const locale = data.locale === 'en' ? 'en' : 'pt-PT';
---
<article id="main-content">
	<DraftNotice locale={locale} approvalPending={data.approvalPending} />
	{service ? <>
		<header class="bg-slate-900 px-6 py-20 text-white" data-tina-field={tinaField(data, 'academicService')}><div class="mx-auto max-w-6xl"><a class="text-sm underline" href={pathFor('academic', locale)}>Academia</a><h1 class="mt-5 text-4xl font-bold md:text-6xl">{data.title}</h1><p class="mt-5 max-w-3xl text-lg text-slate-200">{service.subtitle}</p></div></header>
		<section class="mx-auto max-w-4xl px-6 py-16"><h2 class="text-3xl font-bold">{service.introHeading}</h2><div class="mt-6 space-y-5 text-lg">{service.introParagraphs.map((paragraph) => <p>{paragraph}</p>)}</div></section>
		<section class="bg-slate-50 px-6 py-16"><div class="mx-auto max-w-6xl"><h2 class="text-3xl font-bold">{service.servicesHeading}</h2>{service.servicesSubtitle && <p class="mt-3 max-w-3xl">{service.servicesSubtitle}</p>}<div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{service.services.map((item) => <article class="rounded-lg border bg-white p-5"><h3 class="text-lg font-semibold">{item.title}</h3><p class="mt-3 text-sm">{item.description}</p></article>)}</div></div></section>
		<aside class="mx-auto max-w-4xl px-6 py-10"><p class="border-l-4 border-amber-500 pl-4 text-sm">{service.note}</p></aside>
		<section class="bg-slate-900 px-6 py-16 text-center text-white"><h2 class="text-3xl font-bold">{service.ctaHeading}</h2><p class="mx-auto mt-4 max-w-2xl">{service.ctaText}</p><a class="mt-7 inline-block rounded bg-teal-600 px-5 py-3 font-semibold" href={pathFor('booking', locale)}>Agendar primeiro contacto</a></section>
	</> : <section class="mx-auto min-h-[60vh] max-w-4xl px-6 py-20"><h1>{data.title}</h1><p class="mt-4">{data.summary}</p></section>}
</article>
