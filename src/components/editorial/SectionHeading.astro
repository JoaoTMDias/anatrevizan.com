---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'header'> {
	title: string;
	subtitle?: string | null;
	eyebrow?: string | null;
	centered?: boolean;
}

const { title, subtitle, eyebrow, centered = false, class: className, ...rest } = Astro.props;
---

<header class:list={['editorial-section-heading', centered && 'text-center mx-auto', className]} {...rest}>
	{eyebrow && <p class="editorial-eyebrow">{eyebrow}</p>}
	<h2>{title}</h2>
	{subtitle && <p class:list={['editorial-section-heading__subtitle', centered && 'mx-auto']}>{subtitle}</p>}
</header>
