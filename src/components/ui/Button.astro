---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";
import { cn } from "../../lib/cn";
import { isExternalHref } from "../../lib/external-url";

const button = tv({
  base: "inline-flex min-h-11 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-full text-base font-medium transition-colors disabled:pointer-events-none disabled:opacity-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
  variants: {
    variant: {
      default: "bg-primary text-primary-foreground shadow-sm hover:bg-primary/90",
      accent: "bg-accent text-accent-foreground shadow-sm hover:bg-accent/90",
      accentBlack: "bg-black text-white shadow-sm hover:bg-black/90",
      destructive: "bg-destructive text-white shadow-xs hover:bg-destructive/90",
      outline:
        "backdrop-blur border-2 border-primary bg-white/10 text-primary hover:bg-primary hover:text-primary-foreground",
      outlineBlack:
        "backdrop-blur border-2 border-black bg-white/10 text-black hover:bg-black hover:text-white focus:bg-black focus:text-white",
      outlineInverse:
        "backdrop-blur border-2 border-primary-foreground bg-white/10 text-primary-foreground hover:bg-primary-foreground hover:text-primary",
      secondary: "bg-secondary text-secondary-foreground shadow-xs hover:bg-white",
      ghost: "hover:bg-accent hover:text-accent-foreground",
      link: "min-h-0 rounded-none p-0 text-primary underline decoration-1 underline-offset-4 hover:decoration-2",
    },
    size: {
      default: "px-6 py-3",
      sm: "min-h-11 gap-1.5 px-5 py-2",
      lg: "min-h-12 px-8 py-3",
      icon: "size-11 p-0",
    },
  },
  defaultVariants: { variant: "default", size: "default" },
});

type Props = VariantProps<typeof button> &
  Omit<HTMLAttributes<"a">, "href"> &
  Omit<HTMLAttributes<"button">, "type"> & {
    href?: string | null;
  };

const { variant, size, href, class: className, target, rel, ...rest } = Astro.props;
const classes = cn(button({ variant, size }), className);
const external = isExternalHref(href);
const linkTarget = external ? "_blank" : target;
const linkRel = external
  ? [...new Set(`${rel ?? ""} external noopener noreferrer`.trim().split(/\s+/))].join(" ")
  : rel;
---

{
  href ? (
    <a
      href={href}
      class={classes}
      target={linkTarget}
      rel={linkRel}
      {...(rest as HTMLAttributes<"a">)}
    >
      <slot />
    </a>
  ) : (
    <button class={classes} {...(rest as HTMLAttributes<"button">)}>
      <slot />
    </button>
  )
}
