---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../../lib/cn';

type Props = HTMLAttributes<'div'>;

const { class: className, ...rest } = Astro.props;
---
<div class={cn('flex flex-col gap-6 rounded-lg border bg-card py-6 text-card-foreground shadow-sm transition-[border-color,box-shadow] duration-200', className)} {...rest}>
	<slot />
</div>
