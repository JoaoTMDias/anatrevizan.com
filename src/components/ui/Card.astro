---
import type { HTMLAttributes } from 'astro/types';
import { cn } from '../../lib/cn';

type Props = HTMLAttributes<'div'> & {
	as?: 'article' | 'div';
};

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---
<Tag class={cn('flex flex-col gap-6 rounded-lg border bg-card py-6 text-card-foreground shadow-sm transition-[border-color,box-shadow] duration-200', className)} {...rest}>
	<slot />
</Tag>
