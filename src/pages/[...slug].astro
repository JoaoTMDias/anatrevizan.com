---
import LocalizedPage from '../components/LocalizedPage.astro';
import { isEditorialPreviewEnabled } from '../lib/editorial';
import { resolveEditorialPages } from '../lib/editorial-page';
import { routeKeys, routeMap } from '../lib/routing';

export async function getStaticPaths() {
	const previewEnabled = isEditorialPreviewEnabled();
	const pages = await resolveEditorialPages(previewEnabled);

	return routeKeys.flatMap((routeKey) => {
		const localizedPaths = [
			...(routeMap[routeKey]['pt-PT'] === '/'
				? []
				: [{
						params: { slug: routeMap[routeKey]['pt-PT'].slice(1) },
						props: { routeKey, locale: 'pt-PT' as const },
					}]),
			{ params: { slug: routeMap[routeKey].en.slice(1) }, props: { routeKey, locale: 'en' as const } },
		].filter(({ props }) => {
			if (!props) return true;
			return pages.has(`${props.routeKey}:${props.locale}`);
		});

		return localizedPaths.map(({ params, props }) => ({
			params,
			props: props ? { page: pages.get(`${props.routeKey}:${props.locale}`) } : props,
		}));
	});
}
const { page } = Astro.props;
---
{page ? <LocalizedPage page={page} /> : null}
