---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import { getConfig } from '../lib/data';

const config = (await getConfig()).data.config;
---
<Base title="Página não encontrada" description="A página pedida não existe." locale="pt-PT" routeKey="home" noindex config={config}>
	<section class="not-found-page">
		<div>
			<p>404</p>
			<h1>Página não encontrada</h1>
			<p class="mx-auto mt-4 max-w-md text-muted-foreground">A página pedida não existe ou mudou de endereço.</p>
			<Button href="/" class="mt-8">Voltar ao início</Button>
		</div>
	</section>
</Base>
