---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import TinaIsland from "@tinacms/astro/TinaIsland.astro";
import type { CmsConfig } from "../lib/data";
import { islands } from "../lib/islands";
import type { PublishedLocale, RouteKey } from "../lib/routing";
interface Props {
  title: string;
  description: string;
  locale: PublishedLocale;
  routeKey: RouteKey;
  image?: string;
  noindex?: boolean;
  availableLocales?: PublishedLocale[];
	lastModified?: string;
  config?: CmsConfig | null;
}
const props = Astro.props;
const config = props.config ?? null;
---

<!doctype html>
<html lang={props.locale === "en" ? "en" : "pt-PT"}>
  <head>
    <script is:inline>
      (() => {
        let savedTheme = null;
        try {
          savedTheme = localStorage.getItem("theme");
        } catch {}
        const isDark =
          savedTheme === "dark" ||
          (savedTheme !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", isDark);
      })();
    </script>
    <BaseHead {...props} />
  </head>
  <body>
    <TinaIsland
      name="global"
      wrapper={islands.global.wrapper}
      params={{ locale: props.locale, routeKey: props.routeKey }}
      ><Header
        config={config}
        locale={props.locale}
        routeKey={props.routeKey}
        languageAvailable={props.availableLocales?.includes(props.locale === "en" ? "pt-PT" : "en")}
      /></TinaIsland
    >
    <slot />
    <script src="../scripts/acronym-tooltips.ts"></script>
    <TinaIsland
      name="global-footer"
      wrapper={islands["global-footer"].wrapper}
      params={{ locale: props.locale, routeKey: props.routeKey }}
      ><Footer config={config} locale={props.locale} /></TinaIsland
    >
  </body>
</html>
