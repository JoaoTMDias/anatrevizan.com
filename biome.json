{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"files": {
		"includes": [
			"**/*.{js,jsx,ts,tsx,json,jsonc,css}",
			"!node_modules",
			"!dist",
			"!.astro",
			"!public/admin",
			"!tina/__generated__"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	}
}
